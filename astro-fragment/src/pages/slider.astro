---
import SliderAstro from "../components/Slider.astro";
import type {SliderEvent} from "../interfaces/sliderEvent.interface.ts";
import { SliderComponent } from "../components/angular-components/angular-slider/slider";

export const partial = true;

const events: SliderEvent[] = [
    {title: "Event 1", price: 100},
    {title: "Event 2", price: 300, imageUrl: "/openair2.png"},
    {title: "Event 3", price: 120},
    {title: "Event 4", price: 200, imageUrl: "/openair2.png"},
]
---
<SliderAstro events={events}></SliderAstro>
<SliderAstro events={events}></SliderAstro>
<div>---------</div>
<!-- @ts-ignore -->
<SliderComponent events={events} client:load></SliderComponent>